<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Jogador 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvJogador1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Medium"
            tools:text="Jogador 1:" />

        <TextView
            android:id="@+id/tvPontos1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/zero"
            android:textAppearance="@android:style/TextAppearance.Large"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btJog1Mais1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_1" />

        <Button
            android:id="@+id/btJog1Mais3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_3" />

        <Button
            android:id="@+id/btJog1Mais6"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_6" />

        <Button
            android:id="@+id/btJog1Mais9"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_9" />

        <Button
            android:id="@+id/btJog1Mais12"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_12" />
    </LinearLayout>

    <!-- Jogador 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvJogador2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Medium"
            tools:text="Jogador 2:" />

        <TextView
            android:id="@+id/tvPontos2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/zero"
            android:textAppearance="@android:style/TextAppearance.Large"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <Button
            android:id="@+id/btJog2Mais1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_1" />

        <Button
            android:id="@+id/btJog2Mais3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_3" />

        <Button
            android:id="@+id/btJog2Mais6"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_6" />

        <Button
            android:id="@+id/btJog2Mais9"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_9" />

        <Button
            android:id="@+id/btJog2Mais12"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:onClick="btPontuarOnClick"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/mais_12" />
    </LinearLayout>

    <!-- Ações -->
    <Button
        android:id="@+id/btHistorico"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:onClick="btHistoricoOnClick"
        android:text="@string/hist_jogadas" />

    <Button
        android:id="@+id/btZerarHistorico"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:onClick="btZerarHistoricoOnClick"
        android:text="@string/zerar_historico" />

    <Button
        android:id="@+id/btInfNomes"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:onClick="btInfNomesOnClick"
        android:text="@string/inf_nomes" />

</LinearLayout>
